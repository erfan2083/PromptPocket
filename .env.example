# Firebase Configuration (get from Firebase Console → Project Settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth Client ID (get from Google Cloud Console → APIs & Services → Credentials)
# Must be a "Chrome Extension" type OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=
