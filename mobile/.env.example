# Firebase Configuration (same values as the extension - get from Firebase Console)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client IDs (get from Google Cloud Console → APIs & Services → Credentials)
# Web client ID (fallback / server-side verification)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Android client ID (type: Android, with SHA-1 fingerprint + package name)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS client ID (type: iOS, with bundle ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
