# Firebase Configuration (same values as the extension - get from Firebase Console)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client ID (get from Google Cloud Console → APIs & Services → Credentials)
# For mobile: use "Web application" type client ID (Expo uses web redirect)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
